rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Config collection - only readable, admins can write
    match /config/{doc} {
      allow read: if true;
      allow write: if false; // Manage via Firebase Console
    }
    
    // Cards collection - public read, authenticated write
    match /cards/{cardId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null 
        && exists(/databases/$(database)/documents/users/$(request.auth.token.email))
        && get(/databases/$(database)/documents/users/$(request.auth.token.email)).data.status == 'approved';
    }
    
    // Users collection - admins can read all, users can read own
    match /users/{email} {
      allow read: if request.auth != null && (
        request.auth.token.email == email ||
        isAdmin(request.auth.token.email)
      );
      allow create: if request.auth != null && request.auth.token.email == email;
      allow update, delete: if request.auth != null && isAdmin(request.auth.token.email);
    }
    
    // Helper function to check if user is admin
    function isAdmin(email) {
      return exists(/databases/$(database)/documents/config/settings) 
        && email in get(/databases/$(database)/documents/config/settings).data.adminEmails;
    }
  }
}
